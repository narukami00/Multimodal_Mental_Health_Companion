# Set these environment variables in the shell/service before starting uvicorn.
# This file is documentation; it is not loaded automatically.
SOLACE_FIREBASE_PROJECT_ID=solace-self-care-ada87
SOLACE_AUTH_MODE=firebase
# Production revocation checks need server-side Application Default Credentials.
# Configure ADC or GOOGLE_APPLICATION_CREDENTIALS outside this repository.
# Never bundle a service-account private key into the mobile app or source tree.
# SOLACE_CORS_ORIGINS=https://your-allowed-web-origin.example
# Optional emotion service remains private to the companion host.
SOLACE_EMOTION_URL=http://127.0.0.1:8766
