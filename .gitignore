# Keep pubspec.lock committed for the Flutter application

# Android / Gradle
.gradle/
android/.gradle/
android/local.properties
android/key.properties
android/**/GeneratedPluginRegistrant.java

# IDEs and editor metadata
.idea/
*.iml
.vscode/
.DS_Store

# Local configuration and secrets
.env
.env.*
!.env.example
firebase_options.dart

# Test and tool output
*.log
# Anchored: unanchored, this also matched mobile_application/test/screenshots,
# which is source (the render harness), not output.
/screenshots/
debug_recordings/
*.wav
/models/
companion_server/models/
dataset_samples/
*.png
# App icon assets are source, not generated output
!mobile_application/android/app/src/main/res/mipmap*/**
!mobile_application/web/icons/**
!mobile_application/web/favicon.png

# Feature specifications
docs/specifications/
# Research briefs and design write-ups. Working documents for the agent and the
# project owner, not source. Same reasoning as the local progress ledger: the
# useful output is the production code that follows, not the prose that
# preceded it.
docs/research/
docs/design/companion_blob_overhaul.md

# Repo hygiene: local-only working files that must not be pushed
# Any dot-file or dot-directory (agent configs, caches, local metadata).
# Exceptions: keep every .gitignore tracked, keep .env.example available.
.*
!.gitignore
!.env.example

# Design scratch, research notes, generated reports (root and mobile_application)
docs/

# HTML design references captured for UI work
html_ref/
html_refs/

# Working notes: no markdown in the repo except README files
*.md
!README.md

# Literature-review working corpus and the local spec document
/data/
*.docx

