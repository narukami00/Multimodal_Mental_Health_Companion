<?xml version="1.0" encoding="utf-8"?>
<!-- Warm card matching the app palette: cream to a soft peach wash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="315"
        android:startColor="#FFFDF6"
        android:centerColor="#FFF7EA"
        android:endColor="#FFF0E2" />
    <stroke
        android:width="1dp"
        android:color="#F2E4CC" />
</shape>
