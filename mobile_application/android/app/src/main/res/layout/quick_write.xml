<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.18"
        android:text="@string/checkin_widget_eyebrow"
        android:textColor="@color/widget_eyebrow"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/checkin_widget_prompt"
        android:textColor="@color/widget_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/quick_input_background"
        android:gravity="top|start"
        android:hint="@string/quick_write_hint"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="1000"
        android:maxLines="5"
        android:minLines="2"
        android:padding="14dp"
        android:textColor="@color/widget_ink"
        android:textColorHint="@color/widget_eyebrow"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quick_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_write_cancel"
            android:textColor="@color/widget_eyebrow"
            android:textStyle="bold" />

        <Button
            android:id="@+id/quick_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/quick_save_background"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/quick_write_save"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
