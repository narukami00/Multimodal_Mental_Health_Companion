<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ForestWidgetLight">
        <item name="android:background">@drawable/widget_light_badge</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">#354D43</item>
        <item name="android:textSize">11sp</item>
        <item name="android:text">@string/widget_light_day</item>
    </style>

    <style name="ForestWidgetPrompt">
        <item name="android:background">@drawable/widget_light_badge</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#263C34</item>
        <item name="android:textSize">17sp</item>
        <item name="android:text">@string/widget_prompt_default</item>
    </style>

    <style name="ForestWidgetTree">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/widget_sprout</item>
    </style>

    <style name="ForestWidgetAction">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">#2C5143</item>
    </style>
</resources>
